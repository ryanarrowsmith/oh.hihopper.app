# oh.hihopper.app -- the Hopper application
NEXT_PUBLIC_SUPABASE_URL=https://yqgowjvajqspcgskodgd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Zs1XF-4QejL-B41WIsUMNA_w0WOWXOU

# Public site, used by the sign-in screen's "no account" path
NEXT_PUBLIC_SITE_URL=https://hihopper.app

# Mail. Resend, the same provider the auth templates already go through.
# Without these the Send button stands down and says so, rather than
# reporting a success for a message that went nowhere.
RESEND_API_KEY=
MAIL_FROM=Hopper <noreply@hihopper.app>
NEXT_PUBLIC_APP_URL=https://oh.hihopper.app

# Maps. Server-side only: map images are proxied through /api/map so the token
# never reaches the browser. MAPBOX_STYLE / MAPBOX_STYLE_DARK take a Studio
# style as "username/styleid"; without them it falls back to Mapbox's own
# light-v11 and dark-v11.
MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox/light-v11
MAPBOX_STYLE_DARK=mapbox/dark-v11
